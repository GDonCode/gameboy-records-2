# ─── Gameboy Records — environment variables ─────────────────────────────────
# Copy to .env.local for development. On Hostinger, add these in hPanel → Websites → your Node.js app → Environment variables.

# Public site address (used for canonical URLs, sitemap and share cards)
NEXT_PUBLIC_SITE_URL=https://www.gameboyrecords.com

# Development password gate. Set it to keep the site private; remove it to launch.
SITE_PASSWORD=

# Auth.js (next-auth v5)
AUTH_SECRET=                      # openssl rand -base64 32
NEXTAUTH_URL=https://www.gameboyrecords.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=     # Google One Tap / Sign in with Google

# Supabase (members, Club Points, carts, wishlists, orders, media bucket)
NEXT_PUBLIC_SUPABASE_URL=https://ggkhbhwqjlsmushwkgwn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server only, never expose

# WooCommerce store (Tapstitch syncs products into it and fulfils its orders)
WOOCOMMERCE_URL=                  # e.g. https://store.gameboyrecords.com — products appear once this is set
WOOCOMMERCE_CONSUMER_KEY=         # WooCommerce → Settings → Advanced → REST API (Read/Write)
WOOCOMMERCE_CONSUMER_SECRET=
WOOCOMMERCE_WEBHOOK_SECRET=       # secret on the "Order updated" webhook → /api/webhooks/woocommerce

# YouTube Data API (Music page; falls back to a built-in list without it)
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=UC2M7qSo99KTIq-WgnCNq50Q   # official Alexx A-Game channel

# Email (account codes, support requests)
EMAIL_USER=
EMAIL_PASS=
SUPPORT_EMAIL=info@gbrecords.org
